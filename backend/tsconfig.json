{
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  },
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*.ts",
    "knexfile.ts",
    "migrations/**/*.ts",
    "seeds/**/*.ts",
    "scripts/**/*.ts"
  ]
}
