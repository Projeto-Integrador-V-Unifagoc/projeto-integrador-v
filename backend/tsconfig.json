{
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  },
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES6",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*.ts",
    "knexfile.ts",
    "migrations/**/*.ts",
    "seeds/**/*.ts"
  ]
}
