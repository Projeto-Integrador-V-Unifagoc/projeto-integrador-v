JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# URL pela qual o navegador do usuário acessa a API (em produção é /api)
VITE_API_URL=/api

# Destino do botao "Portal do aluno" no site publico.
# Em desenvolvimento deixe vazio para usar a rota /login do proprio app.
# Em producao aponte para o subdominio do sistema.
VITE_URL_PORTAL=https://portal.unieduca.net.br/login

# Configurações obrigatórias de banco de dados
DATABASE_NAME=projeto_integrador
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=altere_para_uma_senha_forte_em_producao

# SMTP
EMAIL_MODO_TESTE=false
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=naoresponda@unieduca.net.br
SMTP_PASSWORD=senha-da-caixa-postal
SMTP_FROM_NAME=UniEduca
SMTP_FROM_EMAIL=naoresponda@unieduca.net.br

# Base usada nos links enviados por e-mail (recuperacao de senha, avisos).
# Aponta para o sistema, nao para o site institucional.
FRONTEND_URL=https://portal.unieduca.net.br

# Portal do aluno: botao "entrar no portal" e link de redefinir senha.
# Se ficar vazio, cai no FRONTEND_URL.
URL_PORTAL=https://portal.unieduca.net.br

# Site institucional publico (landing, inscricao, reenvio de documentos).
# Se ficar vazio, cai no FRONTEND_URL.
SITE_URL=https://unieduca.net.br
