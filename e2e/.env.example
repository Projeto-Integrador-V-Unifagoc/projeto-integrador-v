# Configuração da suíte E2E. Copie para `.env` e ajuste conforme o ambiente.
# Nenhum valor aqui pode conter credenciais reais de produção (spec §18).

# URL da API do backend E2E (instância isolada apontada para o banco _e2e).
E2E_API_URL=http://localhost:3100

# URL do frontend (somente para os testes de UI). O frontend precisa ter sido
# buildado apontando para E2E_API_URL; caso contrário os testes de UI são pulados.
E2E_WEB_URL=

# Conexão com o banco EXCLUSIVO de testes. O nome DEVE terminar em _e2e ou _test;
# os helpers recusam qualquer limpeza fora desse padrão (spec §5.1).
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/projeto_integrador_e2e

# Credenciais da secretaria inicial (seed usuario_inicial.ts).
E2E_SECRETARIA_EMAIL=suporte@unieduca.com.br
E2E_SECRETARIA_SENHA=unieduca2026

# Diretório de upload usado pelo backend E2E (para asserções de documentos).
E2E_UPLOAD_DIR=
